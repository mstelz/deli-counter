#!/usr/bin/env python3
"""Admission control for deli. Shell-only installations retain deli's original queue."""
import contextlib
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import math
import os
from pathlib import Path
import shlex
import signal
import subprocess
import sys
import time


def load_inspect():
    loader = importlib.machinery.SourceFileLoader('deli_inspect', str(Path(__file__).with_name('deli-inspect')))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


@contextlib.contextmanager
def locked(path):
    with open(path, 'a+') as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield handle


def busy(path):
    with open(path, 'a+') as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
        except BlockingIOError:
            return True


def memory_reason(required, active, machine, rss, fraction=0.9):
    """Reserve future peaks without counting already resident bytes twice."""
    total, available = machine['mem_total'], machine['mem_avail']
    if not total:
        return ''  # memory readings unavailable: retain slot protection
    budget = int(total * fraction)
    reserved = sum(job['memory'] for job in active)
    if required + reserved > budget:
        return 'waiting for memory reservations'
    growth = sum(max(0, job['memory'] - rss.get(job['pid'], 0)) for job in active)
    if required + growth + (total - budget) > available:
        return 'waiting for available memory'
    return ''


class Scheduler:
    def __init__(self, mode, label, skip_light, argv):
        self.inspect = load_inspect()
        self.dc = self.inspect.dc
        self.root = Path(os.environ.get('DELI_QUEUE_DIR', '/tmp/deli-queue'))
        self.root.mkdir(parents=True, exist_ok=True)
        self.mode, self.argv = mode, argv
        self.pid = os.getpid()
        self.child = None
        self.cancelled = 0
        self.held = []
        self.info = None
        self.jobfile = self.root / f'job-{self.pid}.json'
        self.waitfile = self.root / f'wait-{self.pid}.info'
        self.reasonfile = self.root / f'wait-{self.pid}.reason'
        self.period = float(os.environ.get('DELI_QUEUE_POLL_SECONDS', '5'))
        self.light_limit = int(os.environ.get('DELI_LIGHT_SLOTS', '2'))
        self.fraction = float(os.environ.get('DELI_MEMORY_FRACTION', '0.9'))
        if not math.isfinite(self.period) or self.period <= 0 or self.light_limit < 1 or not 0 < self.fraction <= 1:
            raise ValueError('poll seconds and light slots must be positive; memory fraction must be in (0, 1]')
        self.check_memory = os.environ.get('DELI_MEMORY_CHECK', 'on') != 'off'
        try:
            checkout = subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], stderr=subprocess.DEVNULL, text=True).strip()
        except (OSError, subprocess.CalledProcessError):
            checkout = os.getcwd()
        self.checkout = self.root / ('worktree-' + hashlib.sha1(checkout.encode()).hexdigest()[:12] + '.lock')
        self.desc = f'pid {self.pid} · {label or os.path.basename(checkout)} · {time.strftime("%H:%M:%S")} · {shlex.join(argv)}'
        runs = []
        try:
            _, runs = self.inspect.lookup(argv)
        except Exception as e:
            print(f'deli: profile unavailable; using conservative admission: {e}', file=sys.stderr)
        self.machine = self.dc.machine()
        cls, why = self.inspect.judge(runs, {'cpus': self.dc.NCPU, 'mem_total': self.machine['mem_total']})
        self.light = skip_light == 'on' and mode != 'inspect' and cls == 'light'
        self.memory = math.ceil(max(r['peak_mem'] for r in runs) * 1.2) if runs else int(self.machine['mem_total'] * .25)
        self.explanation = (f'{cls}: {why}; {len(runs)} successful measurements; '
                            f'reserving {self.dc.size(self.memory)} memory ' +
                            ('(20% margin on measured peaks)' if runs else '(unknown command: 25% of RAM)'))

    def slots(self):
        try:
            value = int((self.root / 'slots').read_text().strip())
        except (OSError, ValueError):
            value = int(os.environ.get('DELI_QUEUE_SLOTS', '2'))
        if value < 1:
            raise ValueError('slot count must be positive')
        return value

    def acquire(self, path):
        handle = open(path, 'a+')
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            handle.close()
            return False
        self.held.append(handle)
        return True

    def jobs(self):
        # Also clean metadata from interrupted shell-only clients.
        for path in self.root.glob('wait-*.info'):
            try:
                os.kill(int(path.stem[5:]), 0)
            except PermissionError:
                continue
            except ProcessLookupError:
                path.unlink(missing_ok=True)
                path.with_suffix('.reason').unlink(missing_ok=True)
        jobs = []
        for path in self.root.glob('job-*.json'):
            if path == self.jobfile:
                continue
            # A lease on the metadata file avoids mistaking a reused PID for a live job.
            with open(path, 'r+') as handle:
                try:
                    fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    jobs.append(json.load(handle))
                    continue
            pid = path.stem[4:]
            path.unlink()
            for suffix in (f'wait-{pid}.info', f'wait-{pid}.reason', f'light-{pid}.info'):
                (self.root / suffix).unlink(missing_ok=True)
        return jobs

    def save_job(self, job):
        self.lease.seek(0)
        json.dump(job, self.lease)
        self.lease.truncate()
        self.lease.flush()

    def reason(self, text):
        self.reasonfile.write_text(text + '\n')
        if text != getattr(self, 'last_reason', None):
            print('deli: ' + text, file=sys.stderr)
            self.last_reason = text

    def cancel(self, signum, _frame):
        self.cancelled = signum
        if self.child and self.child.poll() is None:
            # Include descendants so shells/test workers do not survive cancellation.
            try:
                procs = self.dc.read_procs()
                pids = self.dc.tree(self.child.pid, self.dc.children_map(procs))
            except Exception:
                pids = [self.child.pid]
            for pid in reversed(pids):
                try:
                    os.kill(pid, signum)
                except ProcessLookupError:
                    pass

    def run(self):
        signal.signal(signal.SIGTERM, self.cancel)
        signal.signal(signal.SIGINT, self.cancel)
        try:
            return self.admit_and_run()
        finally:
            try:
                with locked(self.root / 'admission.lock'):
                    for path in (self.jobfile, self.waitfile, self.reasonfile, self.info):
                        if path is not None:
                            path.unlink(missing_ok=True)
            except OSError as e:
                print(f'deli: could not clean queue metadata: {e}', file=sys.stderr)
            finally:
                for handle in self.held:
                    handle.close()
                if hasattr(self, 'lease'):
                    self.lease.close()

    def admit_and_run(self):
        print('deli: ' + self.explanation, file=sys.stderr)
        if self.check_memory and self.machine['mem_total'] and self.memory > self.machine['mem_total'] * self.fraction:
            print('deli: estimated memory exceeds the admission budget; inspect/forget the profile or explicitly set DELI_MEMORY_CHECK=off', file=sys.stderr)
            return 75
        lane = 'light' if self.light else 'slot'
        with locked(self.root / 'admission.lock'):
            ticket = max((j['ticket'] for j in self.jobs()), default=0) + 1
            self.lease = open(self.jobfile, 'w+')
            fcntl.flock(self.lease, fcntl.LOCK_EX)
            job = dict(pid=self.pid, ticket=ticket, lane=lane, active=False,
                       ready=False, checkout=str(self.checkout), memory=self.memory)
            self.save_job(job)
        self.waitfile.write_text(self.desc + ' (checkout)\n')
        while not self.cancelled:
            with locked(self.root / 'admission.lock'):
                jobs = self.jobs()
                older_checkout = any(j.get('checkout') == str(self.checkout) and j['ticket'] < ticket for j in jobs)
                if not older_checkout and self.acquire(self.checkout):
                    job['ready'] = True
                    self.save_job(job)
                    break
                self.reason('waiting for its checkout')
            time.sleep(self.period)
        if self.cancelled:
            return 128 + self.cancelled
        self.waitfile.write_text(self.desc + '\n')
        while not self.cancelled:
            with locked(self.root / 'admission.lock'):
                jobs = self.jobs()
                earlier = [j for j in jobs if not j['active'] and j.get('ready', True) and j['lane'] == lane and j['ticket'] < ticket]
                active = [j for j in jobs if j['active']]
                reason = ''
                if earlier:
                    reason = f'position {len(earlier) + 1} in {lane} queue'
                elif self.check_memory:
                    procs = self.dc.read_procs()
                    kids = self.dc.children_map(procs)
                    rss = {j['pid']: sum(procs[p].rss for p in self.dc.tree(j['pid'], kids) if p in procs) for j in active}
                    reason = memory_reason(self.memory, active, self.dc.machine(), rss, self.fraction)
                if not reason:
                    # Slot locks also honor commands started by older shell-only clients.
                    limit = self.light_limit if self.light else self.slots()
                    occupied = sum(busy(path) for path in self.root.glob(f'{lane}-*.lock'))
                    candidates = range(1, limit + 1) if occupied < limit else ()
                    for n in candidates:
                        if self.acquire(self.root / f'{lane}-{n}.lock'):
                            self.info = self.root / (f'light-{self.pid}.info' if self.light else f'slot-{n}.info')
                            job['active'] = True
                            self.save_job(job)
                            self.info.write_text(self.desc + '\n')
                            break
                    else:
                        reason = 'waiting for light allowance' if self.light else 'waiting for a slot'
                if not reason:
                    self.waitfile.unlink(missing_ok=True)
                    self.reasonfile.unlink(missing_ok=True)
                    break
                self.reason(reason)
            time.sleep(self.period)
        if self.cancelled:
            return 128 + self.cancelled
        print('deli: admitted to ' + ('light allowance; skipping heavy slots' if self.light else 'a slot'), file=sys.stderr)
        command = self.argv
        if self.mode in ('inspect', 'measure') or self.light:
            command = [sys.executable, str(Path(__file__).with_name('deli-inspect')), 'run']
            if self.mode != 'inspect':
                command.append('--quiet')
            command += ['--'] + self.argv
        try:
            self.child = subprocess.Popen(command)
        except OSError as e:
            print(f'deli: {e}', file=sys.stderr)
            return 127
        if self.cancelled:
            self.cancel(self.cancelled, None)
        rc = self.child.wait()
        return 128 + self.cancelled if self.cancelled else (128 - rc if rc < 0 else rc)


def main():
    try:
        return Scheduler(sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[5:]).run()
    except (OSError, ValueError) as e:
        print(f'deli: scheduler error: {e}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
