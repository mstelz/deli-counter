#!/usr/bin/env bash
# Run a heavy command (tests, typecheck, builds, bundling, model evals) only when a slot is free.
#
# Why: parallel AI agents (Claude, Codex, Gemini) across several projects overload the machine. Under
# load, tests time out, the task killer ends runs half-way, and the work is lost. A queue turns
# "everyone runs at once and half die" into "a few run at a time and all finish".
#
# Two locks, taken in this order:
#   1. per checkout (git toplevel, else cwd): agents in one checkout often share state (a test
#      database, build output), so two heavy runs there must never overlap;
#   2. one of N machine-wide slots under /tmp/deli-queue.
# Locks are flock(1) locks: the kernel releases them when the process exits, killed or not, so a
# dead run never leaves a stale lock behind.
#
# N is live: the queue's `slots` file (written by `deli --slots N` or deli-counter) wins, then
# DELI_QUEUE_SLOTS, then 2. Waiters re-read it on every poll, so raising it lets them in at once.
# Lowering it never stops a running command; it only keeps new runs out of the slots above N.
#
# Light commands skip the slot. `deli inspect -- <command>` runs a command in the queue while
# measuring its CPU and memory (deli-inspect, next to this script), and saves a profile for this
# machine. Once a command's worst recent run is light for this machine, `deli -- <command>` from
# the same folder still takes the checkout lock but runs without waiting for a slot. Those runs
# are measured too, so a command that grows past light goes back into the queue on its own.
# DELI_FASTPATH=0 turns this off.
#
# Runs on Linux and macOS (bash 3.2 or later). macOS needs flock: `brew install flock`.
#
# Usage:
#   deli [--label <text>] -- <command> [args...]
#   deli --status
#   deli --slots [N]       print, or set, the machine-wide slot count
#   deli inspect [--label <text>] -- <command> [args...]   run it in the queue and measure it
#   deli inspect --show -- <command> [args...]             what is saved for it, and its class
#   deli inspect --forget -- <command> [args...]
#   deli inspect --list                                    every command measured on this machine
#   deli                   (interactive) opens the deli-counter dashboard
set -euo pipefail

QUEUE_DIR="${DELI_QUEUE_DIR:-/tmp/deli-queue}"
SLOTS_FILE="$QUEUE_DIR/slots"
POLL_SECONDS="${DELI_QUEUE_POLL_SECONDS:-5}"
mkdir -p "$QUEUE_DIR"
command -v flock >/dev/null || {
  echo "deli: flock not found (macOS: brew install flock; Linux: it is in util-linux)" >&2
  exit 127
}

# deli-inspect lives next to the real script; deli itself is usually a symlink in ~/.local/bin.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
INSPECT="$(cd "$(dirname "$self")" && pwd)/deli-inspect"
have_inspect() { [ -x "$INSPECT" ] && command -v python3 >/dev/null; }

slot_count() {
  local n
  n="$(cat "$SLOTS_FILE" 2>/dev/null || true)"
  [[ "$n" =~ ^[1-9][0-9]*$ ]] || n="${DELI_QUEUE_SLOTS:-2}"
  echo "$n"
}

status() {
  local f i busy n
  SLOTS="$(slot_count)"
  echo "slots ($SLOTS):"
  # Slots above N that are still running (N was lowered) show until their command ends.
  n="$SLOTS"
  for f in "$QUEUE_DIR"/slot-*.lock; do
    [ -e "$f" ] || continue
    i="$(basename "$f" .lock)"; i="${i#slot-}"
    [[ "$i" =~ ^[0-9]+$ ]] && [ "$i" -gt "$n" ] && n="$i"
  done
  for i in $(seq 1 "$n"); do
    f="$QUEUE_DIR/slot-$i.info"
    busy=1
    flock -n "$QUEUE_DIR/slot-$i.lock" true 2>/dev/null && busy=0
    if [ "$i" -le "$SLOTS" ]; then
      if [ "$busy" = 0 ]; then echo "  slot $i: free"
      else echo "  slot $i: $(cat "$f" 2>/dev/null || echo busy)"; fi
    elif [ "$busy" = 1 ]; then
      echo "  slot $i: $(cat "$f" 2>/dev/null || echo busy) (above limit, finishing)"
    fi
  done
  echo "waiting:"
  for f in "$QUEUE_DIR"/wait-*.info; do
    [ -e "$f" ] || continue
    # A waiter that was killed leaves its file behind; show only live ones.
    w_pid="$(basename "$f" .info | sed 's/^wait-//')"
    if kill -0 "$w_pid" 2>/dev/null; then
      echo "  $(cat "$f")"
    fi
  done
}

if [ $# -eq 0 ]; then
  if [ -t 0 ] && [ -t 1 ] && command -v deli-counter >/dev/null 2>&1; then
    exec deli-counter
  fi
  echo "usage: $0 [inspect] [--label <text>] -- <command> [args...]   |   $0 --status   |   $0 --slots [N]" >&2
  echo "       $0 inspect --list | --show -- <command> | --forget -- <command>" >&2
  echo "       $0 (interactive) opens the deli-counter dashboard" >&2
  exit 2
fi

if [ "${1:-}" = "--status" ]; then status; exit 0; fi
if [ "${1:-}" = "--slots" ]; then
  if [ $# -lt 2 ]; then slot_count; exit 0; fi
  [[ "$2" =~ ^[1-9][0-9]*$ ]] || { echo "deli: --slots needs a positive integer" >&2; exit 2; }
  # Write then rename, so a poller never reads a half-written file.
  printf '%s\n' "$2" >"$SLOTS_FILE.$$" && mv -f "$SLOTS_FILE.$$" "$SLOTS_FILE"
  echo "slots: $2"
  exit 0
fi

MODE=run
if [ "${1:-}" = "inspect" ]; then
  shift
  have_inspect || { echo "deli: inspect needs python3 and $INSPECT" >&2; exit 127; }
  case "${1:-}" in
    --list) exec "$INSPECT" list ;;
    --show) shift; exec "$INSPECT" show "$@" ;;
    --forget) shift; exec "$INSPECT" forget "$@" ;;
  esac
  MODE=inspect
fi

LABEL=""
if [ "${1:-}" = "--label" ]; then LABEL="$2"; shift 2; fi
if [ "${1:-}" != "--" ]; then
  echo "usage: $0 [inspect] [--label <text>] -- <command> [args...]   |   $0 --status" >&2
  exit 2
fi
shift
[ $# -gt 0 ] || { echo "deli: no command given" >&2; exit 2; }

WORKTREE="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# sha1sum on Linux, shasum on macOS: the same SHA-1, so a checkout's lock name matches on both.
if command -v sha1sum >/dev/null; then HASH=sha1sum; else HASH=shasum; fi
WT_KEY="$(printf '%s' "$WORKTREE" | "$HASH" | cut -c1-12)"
DESC="pid $$ · ${LABEL:-$(basename "$WORKTREE")} · $(date +%H:%M:%S) · $*"
WAIT_FILE="$QUEUE_DIR/wait-$$.info"
trap 'rm -f "$WAIT_FILE"' EXIT

# Measured light on this machine: skip the slot (but not the checkout lock, below).
LIGHT=""
if [ "$MODE" = run ] && [ "${DELI_FASTPATH:-1}" != 0 ] && have_inspect; then
  LIGHT="$("$INSPECT" class -- "$@" 2>/dev/null)" || LIGHT=""
fi

# 1. The checkout lock (blocking). fd 8 is held until this script exits.
exec 8>"$QUEUE_DIR/worktree-$WT_KEY.lock"
if ! flock -n 8; then
  echo "deli: waiting for another run in this checkout ($WORKTREE)" >&2
  echo "$DESC (checkout)" >"$WAIT_FILE"
  flock 8
fi

if [ -n "$LIGHT" ]; then
  echo "deli: light on this machine (${LIGHT#*	}); running without a slot" >&2
  rm -f "$WAIT_FILE"
  set +e
  "$INSPECT" run --quiet -- "$@" 8>&-
  rc=$?
  set -e
  exit "$rc"
fi

# 2. A machine-wide slot. Poll every slot without blocking, so we take whichever frees first.
announced=0
while :; do
  SLOTS="$(slot_count)"
  for i in $(seq 1 "$SLOTS"); do
    exec 9>"$QUEUE_DIR/slot-$i.lock"
    if flock -n 9; then
      rm -f "$WAIT_FILE"
      echo "$DESC" >"$QUEUE_DIR/slot-$i.info"
      [ "$announced" = 1 ] && echo "deli: got slot $i" >&2
      # Run as a child, not exec: fds 8 and 9 stay held by this shell until the command ends.
      set +e
      # The child must not inherit the locks, or a daemon it leaves behind would hold them.
      if [ "$MODE" = inspect ]; then "$INSPECT" run -- "$@" 8>&- 9>&-
      else "$@" 8>&- 9>&-; fi
      rc=$?
      set -e
      : >"$QUEUE_DIR/slot-$i.info"
      exit "$rc"
    fi
    exec 9>&-
  done
  if [ "$announced" = 0 ]; then
    echo "deli: all $SLOTS slots busy; queued (see: $0 --status)" >&2
    echo "$DESC" >"$WAIT_FILE"
    announced=1
  fi
  sleep "$POLL_SECONDS"
done
