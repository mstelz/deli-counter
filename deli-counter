#!/usr/bin/env python3
"""Live terminal dashboard for the deli-counter work queue.

deli keeps its state as plain files in $DELI_QUEUE_DIR (default /tmp/deli-queue):
  slot-N.info    "pid P · label · HH:MM:SS · command" while slot N is running, empty when free
  wait-P.info    the same line for a queued run, suffixed " (checkout)" when it waits on its
                 own checkout's lock rather than on a machine-wide slot
  slots          the live slot count, if set; deli re-reads it on every poll
A killed run can leave either file behind, so an entry counts only while its pid is alive and
is still a deli process. The dashboard never touches the locks. The one thing it writes is
the slots file, when you change the slot count.

Beyond what `deli --status` prints, it measures real run and wait times, the CPU and
memory of each run's whole process tree, machine load and memory, and a history of runs that
finished while the dashboard was open. Linux and macOS; Python 3 standard library only.

Usage: deli-counter [--interval SECONDS] [--once]
Keys:  ? help · q quit · r refresh now · + / - slot count · [ / ] refresh interval
       Tab browse finished runs (↑↓ PgUp PgDn Home End, Enter details, Esc back)
"""

import argparse
import curses
import os
import re
import subprocess
import sys
import time
import unicodedata
from collections import deque
from dataclasses import dataclass, field

QUEUE_DIR = os.environ.get("DELI_QUEUE_DIR", "/tmp/deli-queue")
SLOTS_FILE = os.path.join(QUEUE_DIR, "slots")
DEFAULT_SLOTS = int(os.environ.get("DELI_QUEUE_SLOTS", "2"))
MAX_SLOTS = 64
CLK_TCK = os.sysconf("SC_CLK_TCK")
PAGE = os.sysconf("SC_PAGE_SIZE")
NCPU = os.cpu_count() or 1


# ---------------------------------------------------------------- process and machine sampling
#
# Linux reads /proc directly. macOS has no /proc, so it asks ps, lsof, vm_stat and sysctl, which
# ship with the OS. Either way the rest of the dashboard sees the same Proc and machine() values.

LINUX = sys.platform.startswith("linux")


@dataclass
class Proc:
    pid: int
    ppid: int
    cpu: float  # CPU seconds used so far (user + system)
    start: float  # epoch seconds
    rss: int  # bytes
    args: str = ""  # command line; filled on macOS only, Linux reads it on demand


def boot_time():
    with open("/proc/stat") as f:
        for line in f:
            if line.startswith("btime "):
                return int(line.split()[1])
    return 0


BOOT = boot_time() if LINUX else 0


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def read_procs_linux():
    procs = {}
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        try:
            with open(f"/proc/{name}/stat") as f:
                raw = f.read()
        except OSError:
            continue
        # The command name (field 2) may hold spaces and parens; split after its last ')'.
        rest = raw[raw.rfind(")") + 2 :].split()
        procs[int(name)] = Proc(
            pid=int(name),
            ppid=int(rest[1]),
            cpu=(int(rest[11]) + int(rest[12])) / CLK_TCK,
            start=BOOT + int(rest[19]) / CLK_TCK,
            rss=int(rest[21]) * PAGE,
        )
    return procs


def ps_duration(text):
    """ps times: '[[DD-]HH:]MM:SS' (etime, Linux cputime) or 'MM:SS.ss' (macOS cputime)."""
    days, _, text = text.rpartition("-")
    secs = 0.0
    for part in text.split(":"):
        secs = secs * 60 + float(part)
    return (int(days) if days else 0) * 86400 + secs


def read_procs_ps():
    now = time.time()
    procs = {}
    for line in run("ps", "-axo", "pid=,ppid=,rss=,time=,etime=,args=").splitlines():
        f = line.split(None, 5)
        try:
            pid, ppid, rss = int(f[0]), int(f[1]), int(f[2]) * 1024
            cpu, age = ps_duration(f[3]), ps_duration(f[4])
        except (ValueError, IndexError):
            continue
        # etime has whole seconds, so this start can be up to a second early.
        procs[pid] = Proc(pid, ppid, cpu, now - age, rss, f[5] if len(f) > 5 else "")
    return procs


def read_procs():
    return read_procs_linux() if LINUX else read_procs_ps()


def children_map(procs):
    kids = {}
    for p in procs.values():
        kids.setdefault(p.ppid, []).append(p.pid)
    return kids


def tree(pid, kids):
    out, stack = [], [pid]
    while stack:
        p = stack.pop()
        out.append(p)
        stack.extend(kids.get(p, ()))
    return out


def is_deli(pid, procs):
    if not LINUX:
        return "deli" in procs[pid].args
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return b"deli" in f.read()
    except OSError:
        return False


def cwd_of(pid):
    if LINUX:
        try:
            return os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            return None
    # lsof -F prints one field per line; the cwd's path is the line starting with 'n'.
    for line in run("lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn").splitlines():
        if line.startswith("n"):
            return line[1:]
    return None


_checkouts = {}  # pid -> checkout; a run's cwd never changes, and lsof is slow on macOS


def checkout_of(pid):
    """The checkout deli keys its per-checkout lock on: git toplevel of its cwd, else cwd."""
    if pid in _checkouts:
        return _checkouts[pid]
    d = cwd_of(pid)
    if d is None:
        return None
    probe = d
    while not os.path.exists(os.path.join(probe, ".git")):
        parent = os.path.dirname(probe)
        if parent == probe:
            probe = d
            break
        probe = parent
    _checkouts[pid] = probe
    return probe


def forget_checkouts(live_pids):
    for pid in [p for p in _checkouts if p not in live_pids]:
        del _checkouts[pid]


def machine_linux():
    mem = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":", 1)
            mem[k] = int(v.split()[0]) * 1024
    return {
        "mem_total": mem.get("MemTotal", 0),
        "mem_avail": mem.get("MemAvailable", 0),
        "swap_used": mem.get("SwapTotal", 0) - mem.get("SwapFree", 0),
        "swap_total": mem.get("SwapTotal", 0),
    }


def parse_vm_stat(text):
    """Available memory from vm_stat: free, inactive and speculative pages, which macOS hands
    out without swapping."""
    m = re.search(r"page size of (\d+) bytes", text)
    page = int(m.group(1)) if m else PAGE
    pages = {}
    for line in text.splitlines():
        k, _, v = line.partition(":")
        if v.strip().rstrip(".").isdigit():
            pages[k.strip()] = int(v.strip().rstrip("."))
    return sum(pages.get(k, 0) for k in ("Pages free", "Pages inactive", "Pages speculative")) * page


def parse_swapusage(text):
    """sysctl vm.swapusage: 'total = 2048.00M  used = 1034.25M  free = 1013.75M  (encrypted)'."""
    units = {"K": 1024, "M": 1024**2, "G": 1024**3}
    vals = {k: float(n) * units.get(u, 1) for k, n, u in re.findall(r"(\w+) = ([\d.]+)([KMG]?)", text)}
    return int(vals.get("used", 0)), int(vals.get("total", 0))


def machine_macos():
    total = run("sysctl", "-n", "hw.memsize").strip()
    swap_used, swap_total = parse_swapusage(run("sysctl", "-n", "vm.swapusage"))
    return {
        "mem_total": int(total) if total.isdigit() else 0,
        "mem_avail": parse_vm_stat(run("vm_stat")),
        "swap_used": swap_used,
        "swap_total": swap_total,
    }


def machine():
    return {"load": os.getloadavg(), **(machine_linux() if LINUX else machine_macos())}


# ---------------------------------------------------------------- queue state


@dataclass
class Entry:
    pid: int
    label: str
    command: str
    submitted: float  # when deli started (epoch)
    checkout_wait: bool = False
    slot: int = 0
    run_start: float = 0.0  # when the command itself started (epoch), slots only
    checkout: str = ""
    blocked_by: int = 0  # slot holding this waiter's checkout, if any
    cpu: float = 0.0  # percent of one core
    rss: int = 0
    nprocs: int = 0


def parse_info(text):
    """'pid P · label · HH:MM:SS · command' -> (pid, label, command, checkout)."""
    parts = text.strip().split(" · ", 3)
    if len(parts) < 4 or not parts[0].startswith("pid "):
        return None
    cmd, checkout = parts[3], False
    if cmd.endswith(" (checkout)"):
        cmd, checkout = cmd[: -len(" (checkout)")], True
    try:
        pid = int(parts[0][4:])
    except ValueError:
        return None
    return pid, parts[1], cmd, checkout


def read_file(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def slot_limit():
    """The live slot count, read as deli reads it: slots file, then AGENT_QUEUE_SLOTS, then 2."""
    text = read_file(SLOTS_FILE).strip()
    return int(text) if re.fullmatch(r"[1-9][0-9]*", text) else DEFAULT_SLOTS


def set_slot_limit(n):
    os.makedirs(QUEUE_DIR, exist_ok=True)
    tmp = f"{SLOTS_FILE}.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(f"{n}\n")
    os.replace(tmp, SLOTS_FILE)  # a poller never sees a half-written file


def highest_slot():
    """Highest N with a slot-N.lock. Slots above the limit may still be finishing a run."""
    n = 0
    try:
        for name in os.listdir(QUEUE_DIR):
            if name.startswith("slot-") and name.endswith(".lock") and name[5:-5].isdigit():
                n = max(n, int(name[5:-5]))
    except OSError:
        pass
    return n


@dataclass
class Snapshot:
    at: float
    nslots: int  # the limit
    slots: dict  # slot number -> Entry or None; slots above the limit appear only while busy
    waiting: list
    machine: dict
    ok: bool = True


@dataclass
class Sampler:
    prev_cpu: dict = field(default_factory=dict)
    prev_at: float = 0.0
    running: dict = field(default_factory=dict)  # deli pid -> Entry, to detect finishes
    history: deque = field(default_factory=lambda: deque(maxlen=500))
    finished: int = 0  # total ever added to history, so a view can tell how many are new

    def sample(self):
        now = time.time()
        ok = os.path.isdir(QUEUE_DIR)
        procs = read_procs()
        kids = children_map(procs)
        dt = now - self.prev_at if self.prev_at else 0.0
        cpu_now = {}

        def measure(e):
            pids = [p for p in tree(e.pid, kids) if p in procs]
            e.nprocs = len(pids) - 1  # not counting deli itself
            e.rss = sum(procs[p].rss for p in pids)
            total = 0
            for p in pids:
                cpu_now[p] = procs[p].cpu
                if dt and p in self.prev_cpu:
                    total += max(0.0, procs[p].cpu - self.prev_cpu[p])
            e.cpu = 100.0 * total / dt if dt else 0.0
            direct = [procs[c].start for c in kids.get(e.pid, ()) if c in procs]
            e.run_start = min(direct) if direct else now

        nslots = slot_limit()
        slots = {}
        for i in range(1, max(nslots, highest_slot()) + 1):
            info = parse_info(read_file(os.path.join(QUEUE_DIR, f"slot-{i}.info")))
            if info and info[0] in procs and is_deli(info[0], procs):
                pid, label, cmd, _ = info
                e = Entry(pid, label, cmd, procs[pid].start, slot=i, checkout=checkout_of(pid) or "")
                measure(e)
                slots[i] = e
            elif i <= nslots:
                slots[i] = None

        waiting = []
        try:
            names = os.listdir(QUEUE_DIR) if ok else []
        except OSError:
            names = []
        for name in names:
            if not (name.startswith("wait-") and name.endswith(".info")):
                continue
            info = parse_info(read_file(os.path.join(QUEUE_DIR, name)))
            if not info or info[0] not in procs or not is_deli(info[0], procs):
                continue
            pid, label, cmd, checkout = info
            if any(s and s.pid == pid for s in slots.values()):
                continue  # between taking a slot and removing its wait file
            e = Entry(pid, label, cmd, procs[pid].start, checkout_wait=checkout,
                      checkout=checkout_of(pid) or "")
            if checkout:
                e.blocked_by = next((s.slot for s in slots.values()
                                     if s and s.checkout and s.checkout == e.checkout), 0)
            waiting.append(e)
        waiting.sort(key=lambda e: e.submitted)

        live = {e.pid: e for e in slots.values() if e}
        for pid, e in self.running.items():
            if pid not in live:
                self.history.appendleft((now, e))
                self.finished += 1
        self.running = live
        forget_checkouts(procs)
        self.prev_cpu, self.prev_at = cpu_now, now
        return Snapshot(now, nslots, slots, waiting, machine(), ok)


