def top_rows(snap):
    """Header, slots and waiting, as a list of rows; each row is a list of (text, style) spans.
    Styles: 'title', 'dim', 'busy', 'free', 'warn', 'bad', 'wait', 'check', ''."""
    rows = []
    m = snap.machine
    busy = sum(1 for e in snap.slots.values() if e)
    load1 = m["load"][0]
    load_style = "bad" if load1 > NCPU * 1.5 else "warn" if load1 > NCPU else ""
    avail_frac = m["mem_avail"] / m["mem_total"] if m["mem_total"] else 1
    mem_style = "bad" if avail_frac < 0.1 else "warn" if avail_frac < 0.25 else ""
    swap = []
    if m["swap_total"]:
        sw_frac = m["swap_used"] / m["swap_total"]
        swap = [("  swap ", "dim"), (f"{size(m['swap_used'])}/{size(m['swap_total'])}",
                                    "bad" if sw_frac > 0.8 else "warn" if sw_frac > 0.4 else "")]

    rows.append([
        (" 🥪 deli-counter ", "title"),
        (f"  {busy}/{snap.nslots} slots busy", "busy" if busy >= snap.nslots else "free"),
        (f"  {len(snap.waiting)} waiting", "wait" if snap.waiting else "dim"),
        ("   load ", "dim"),
        (" ".join(f"{x:.1f}" for x in m["load"]), load_style),
        (f" (1/5/15m) on {NCPU} cores", "dim"),
        ("  mem avail ", "dim"),
        (f"{size(m['mem_avail'])}/{size(m['mem_total'])}", mem_style),
        *swap,
        (f"   {clock(snap.at)}", "dim"),
    ])
    text, style = advice(snap, busy)
    rows.append([(" ", ""), (text, style)])
    if not snap.ok:
        rows.append([(f" queue dir {QUEUE_DIR} does not exist yet (nothing has queued)", "warn")])
    rows.append([])

    rows.append([(f" SLOTS ({snap.nslots})", "title")])
    order = sorted(snap.slots)
    for n, i in enumerate(order):
        e = snap.slots[i]
        if not e:
            if n and not snap.slots[order[n - 1]]:
                continue  # part of a run of free slots, drawn by its first one
            last = i
            for j in order[n + 1 :]:
                if snap.slots[j]:
                    break
                last = j
            rows.append([(f"  {i} " if last == i else f"  {i}–{last} ", ""), ("○ free", "free")])
            continue
        queued_for = e.run_start - e.submitted
        rows.append([
            (f"  {i} ", ""),
            ("● ", "busy"),
            (f"{e.label:<24.24} ", "busy"),
            ("ran ", "dim"), (f"{dur(snap.at - e.run_start):>7}", ""),
            ("  queued ", "dim"), (f"{dur(queued_for):>6}", "dim"),
            ("  cpu ", "dim"),
            (f"{e.cpu:>5.0f}%", "bad" if e.cpu > 800 else "warn" if e.cpu > 400 else ""),
            ("  rss ", "dim"), (f"{size(e.rss):>6}", ""),
            ("  procs ", "dim"), (f"{e.nprocs}", ""),
            (f"  pid {e.pid}", "dim"),
            *([("  above limit, finishing", "warn")] if i > snap.nslots else []),
        ])
        rows.append([("      ", ""), (e.command, "dim")])
    rows.append([])

    rows.append([(f" WAITING ({len(snap.waiting)})", "title"),
                 ("   oldest first; slot waiters poll every few seconds, so order is a guide", "dim")])
    if not snap.waiting:
        rows.append([("  nothing queued", "dim")])
    for n, e in enumerate(snap.waiting, 1):
        rows.append([
            (f"  #{n:<2} ", ""),
            (f"{e.label:<24.24} ", "wait"),
            ("waiting ", "dim"), (f"{dur(snap.at - e.submitted):>7}", ""),
            ("  on ", "dim"),
            ("a slot" if not e.checkout_wait
             else f"its checkout (slot {e.blocked_by})" if e.blocked_by
             else "its checkout", "check" if e.checkout_wait else ""),
            (f"  pid {e.pid}", "dim"),
        ])
        rows.append([("      ", ""), (e.command, "dim")])
    rows.append([])
    return rows


def finished_row(ended, e):
    return [
        (f"  {clock(ended)} ", "dim"),
        (f"{e.label:<24.24} ", ""),
        ("ran ", "dim"), (f"{dur(ended - e.run_start):>7}", ""),
        ("  queued ", "dim"), (f"{dur(e.run_start - e.submitted):>6}  ", "dim"),
        (e.command, "dim"),
    ]


def finished_detail(ended, e):
    return [
        [("      command  ", "dim"), (e.command, "")],
        [("      checkout ", "dim"), (e.checkout or "?", "")],
        [("      slot ", "dim"), (f"{e.slot}", ""), ("  pid ", "dim"), (f"{e.pid}", ""),
         ("  queued ", "dim"), (clock(e.submitted), ""), ("  started ", "dim"),
         (clock(e.run_start), ""), ("  ended ", "dim"), (clock(ended), ""),
         ("  exit code not recorded by deli", "dim")],
    ]


# ---------------------------------------------------------------- output


def print_once(demo=False):
    s = DemoSampler() if demo else Sampler()
    s.sample()
    if not demo:
        time.sleep(0.5)  # a second sample so cpu% has an interval to measure
    snap = s.sample()
    rows = top_rows(snap) + [[(" FINISHED ", "title"), ("since this dashboard opened", "dim")]]
    rows += [finished_row(ended, e) for ended, e in s.history] or [[("  none yet", "dim")]]
    for row in rows:
        print("".join(text for text, _ in row))


@dataclass
class FinishedView:
    """Cursor and scroll state for the finished list. Rows are items (one run each), and an
    expanded item takes extra lines, so the cursor counts items and the scroll counts lines."""
    focus: bool = False
    cursor: int = 0
    top: int = 0
    expanded: set = field(default_factory=set)  # (pid, ended) of runs showing details
    seen: int = 0  # sampler.finished when last drawn

    def lines(self, history):
        out = []  # (item index, row)
        for n, (ended, e) in enumerate(history):
            out.append((n, finished_row(ended, e)))
            if (e.pid, ended) in self.expanded:
                out += [(n, r) for r in finished_detail(ended, e)]
        return out

    def follow_new(self, sampler):
        """New runs are prepended; keep the cursor on the run it was on while browsing."""
        new, self.seen = sampler.finished - self.seen, sampler.finished
        if self.focus and new:
            self.cursor += new
            self.top += new

    def scroll_into_view(self, lines, height):
        n_items = lines[-1][0] + 1 if lines else 0
        self.cursor = max(0, min(self.cursor, n_items - 1))
        if not self.focus:
            self.top = 0
            return
        mine = [y for y, (n, _) in enumerate(lines) if n == self.cursor]
        if mine:
            if mine[0] < self.top:
                self.top = mine[0]
            if mine[-1] >= self.top + height:
                self.top = max(mine[0], mine[-1] - height + 1) if len(mine) <= height else mine[0]
        self.top = max(0, min(self.top, len(lines) - height))


def run_curses(stdscr, interval, demo=False):
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    has_colors = False
    try:
        if curses.has_colors():
            curses.use_default_colors()
            has_colors = True
    except curses.error:
        pass
    pairs = {"title": curses.COLOR_CYAN, "busy": curses.COLOR_GREEN, "free": curses.COLOR_BLUE,
             "warn": curses.COLOR_YELLOW, "bad": curses.COLOR_RED, "wait": curses.COLOR_MAGENTA,
             "check": curses.COLOR_YELLOW}
    styles = {"": curses.A_NORMAL, "dim": curses.A_DIM}
    if has_colors:
        for n, (name, color) in enumerate(pairs.items(), 1):
            try:
                curses.init_pair(n, color, -1)
                styles[name] = curses.color_pair(n) | (curses.A_BOLD if name in ("title", "bad") else 0)
            except curses.error:
                styles[name] = curses.A_BOLD if name in ("title", "bad") else curses.A_NORMAL
    else:
        for name in pairs:
            styles[name] = curses.A_BOLD if name in ("title", "bad") else curses.A_NORMAL

    def str_width(s):
        return sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in s)

    def draw(y, row, w, extra=0):
        x = 0
        if extra:  # fill the line so a highlighted row reads as one bar
            try:
                stdscr.addstr(y, 0, " " * (w - 1), extra)
            except curses.error:
                pass
        for text, style in row:
            if x >= w - 1:
                break
            text = text[: w - 1 - x]
            try:
                stdscr.addstr(y, x, text, styles.get(style, 0) | extra)
            except curses.error:
                pass
            x += str_width(text)

    sampler = DemoSampler() if demo else Sampler()
    snap = sampler.sample()
    view = FinishedView()
    view.seen = sampler.finished
    flash, flash_until = "", 0.0
    next_at = time.time() + interval
    page = 10
    show_help = False
    while True:
        h, w = stdscr.getmaxyx()
        stdscr.erase()
        if show_help:
            for y, row in enumerate(HELP[: h - 1]):
                draw(y, row, w)
            stdscr.refresh()
            stdscr.timeout(max(50, int((next_at - time.time()) * 1000)))
            if stdscr.getch() != -1:
                show_help = False
            elif time.time() >= next_at:  # keep sampling so finished runs are not missed
                snap = sampler.sample()
                view.follow_new(sampler)
                next_at = time.time() + interval
            continue
        top = top_rows(snap)
        lines = view.lines(sampler.history)
        # The finished list takes whatever the rows above leave, but never under 3 lines.
        list_h = max(3, h - 2 - len(top))
        top = top[: max(0, h - 2 - list_h)]
        page = max(1, list_h - 1)
        view.scroll_into_view(lines, list_h)
        for y, row in enumerate(top):
            draw(y, row, w)

        y = len(top)
        n_items = len(sampler.history)
        title = [(f" FINISHED ({n_items}) ", "title"), ("since this dashboard opened", "dim")]
        if len(lines) > list_h:
            shown = sorted({n for n, _ in lines[view.top : view.top + list_h]})
            title.append((f"   showing {shown[0] + 1}–{shown[-1] + 1}", "dim"))
        if not view.focus and n_items:
            title.append(("   Tab to browse", "dim"))
        draw(y, title, w)
        if not lines:
            draw(y + 1, [("  none yet", "dim")], w)
        for i, (n, row) in enumerate(lines[view.top : view.top + list_h]):
            hl = curses.A_REVERSE if view.focus and n == view.cursor else 0
            draw(y + 1 + i, row, w, hl)

        if time.time() < flash_until:
            footer = f" {flash} "
        elif view.focus:
            footer = " ↑↓ move · PgUp/PgDn · Home/End · Enter details · Esc/Tab back · q quit "
        else:
            footer = (f" ? help · q quit · r refresh now · + - slots: {snap.nslots} · [ ] refresh every {interval:g}s"
                      f" · Tab finished · {QUEUE_DIR} ")
        try:
            stdscr.addstr(h - 1, 0, footer[: w - 1], curses.A_REVERSE)
        except curses.error:
            pass
        stdscr.refresh()

        wake = min(next_at, flash_until) if time.time() < flash_until else next_at
        stdscr.timeout(max(50, int((wake - time.time()) * 1000)))
        key = stdscr.getch()
        refresh = False
        if key in (ord("q"), ord("Q")):
            return
        if key in (ord("?"), ord("h")):
            show_help = True
            continue
        if key == 27:  # Esc leaves the list first, then quits
            if not view.focus:
                return
            view.focus = False
        elif key == 9:  # Tab
            view.focus = not view.focus and bool(sampler.history)
        elif key in (ord("+"), ord("=")) or key in (ord("-"), ord("_")):
            old = sampler.nslots if demo else slot_limit()
            new = max(1, min(MAX_SLOTS, old + (1 if key in (ord("+"), ord("=")) else -1)))
            if new != old:
                if demo:
                    sampler.nslots = new
                    flash = f"slots {old} → {new} (demo mode)"
                else:
                    try:
                        set_slot_limit(new)
                        flash = f"slots {old} → {new} (machine-wide; running jobs are never stopped)"
                    except OSError as err:
                        flash = f"could not write {SLOTS_FILE}: {err.strerror}"
            else:
                flash = f"slots already at {'minimum' if new == 1 else 'maximum'} ({new})"
            flash_until = time.time() + 2.5
            refresh = True
        elif key == ord("]"):
            interval = min(30.0, interval * 2)
            flash, flash_until = f"refresh every {interval:g}s", time.time() + 1.5
        elif key == ord("["):
            interval = max(0.25, interval / 2)
            flash, flash_until = f"refresh every {interval:g}s", time.time() + 1.5
        elif key in (ord("r"), ord("R")):
            flash, flash_until = f"refreshed at {clock(time.time())}", time.time() + 1.0
            refresh = True
        elif view.focus:
            if key in (curses.KEY_UP, ord("k")):
                view.cursor -= 1
            elif key in (curses.KEY_DOWN, ord("j")):
                view.cursor += 1
            elif key == curses.KEY_PPAGE:
                view.cursor -= page
            elif key in (curses.KEY_NPAGE, ord(" ")):
                view.cursor += page
            elif key in (curses.KEY_HOME, ord("g")):
                view.cursor = 0
            elif key in (curses.KEY_END, ord("G")):
                view.cursor = len(sampler.history) - 1
            elif key in (10, 13, curses.KEY_ENTER) and sampler.history:
                view.cursor = max(0, min(view.cursor, len(sampler.history) - 1))
                ended, e = sampler.history[view.cursor]
                view.expanded ^= {(e.pid, ended)}
        if refresh or time.time() >= next_at:
            snap = sampler.sample()
            view.follow_new(sampler)
            next_at = time.time() + interval


def main():
    ap = argparse.ArgumentParser(description="Live dashboard for the deli-counter work queue.")
    ap.add_argument("-n", "--interval", type=float, default=1.0, help="refresh seconds (default 1)")
    ap.add_argument("--once", action="store_true", help="print one snapshot and exit")
    ap.add_argument("--demo", action="store_true", help="run with mock data for demonstration")
    args = ap.parse_args()
    if args.once or not sys.stdout.isatty():
        print_once(demo=args.demo)
        return
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(run_curses, max(0.25, args.interval), args.demo)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
