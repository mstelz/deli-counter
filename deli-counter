# ---------------------------------------------------------------- formatting


def dur(seconds):
    s = max(0, int(seconds))
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m{s % 60:02d}s"
    return f"{s // 3600}h{s % 3600 // 60:02d}m"


def size(n):
    for unit in ("B", "K", "M", "G", "T"):
        if abs(n) < 1024 or unit == "T":
            return f"{n:.0f}{unit}" if unit in ("B", "K", "M") else f"{n:.1f}{unit}"
        n /= 1024
    return f"{n}"


def clock(epoch):
    return time.strftime("%H:%M:%S", time.localtime(epoch))


def advice(snap, busy):
    """One line reading the machine numbers against the slot count: (text, style)."""
    m = snap.machine
    load1, waiting = m["load"][0], len(snap.waiting)
    avail = m["mem_avail"] / m["mem_total"] if m["mem_total"] else 1
    swap = m["swap_used"] / m["swap_total"] if m["swap_total"] else 0
    why = []
    if load1 > NCPU * 1.5:
        why.append(f"load {load1:.0f} is well over {NCPU} cores")
    if avail < 0.1:
        why.append(f"only {size(m['mem_avail'])} memory free")
    if swap > 0.8:
        why.append("swap nearly full")
    if why:
        return (f"overloaded: {', '.join(why)}. Runs will be slow or killed; "
                "lower slots (-) rather than raise them", "bad")
    if load1 > NCPU:
        why.append(f"load {load1:.0f} is over {NCPU} cores")
    if avail < 0.25:
        why.append(f"{size(m['mem_avail'])} memory free")
    if swap > 0.4:
        why.append("swap in heavy use")
    if why:
        return f"busy: {', '.join(why)}. More slots would slow every run", "warn"
    if waiting and busy >= snap.nslots and load1 < NCPU * 0.6:
        return (f"headroom: load {load1:.0f} of {NCPU} cores and memory is fine, "
                f"with {waiting} waiting. Raising slots (+) would likely help", "free")
    return f"ok: load {load1:.0f} of {NCPU} cores, memory fine", "dim"


